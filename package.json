{
  "name": "kestrel-local",
  "private": true,
  "version": "0.17.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @kestrel/desktop",
    "build": "npm run build --workspace @kestrel/desktop",
    "tauri": "tauri",
    "check": "npm run architecture:check && npm run bindings:check && npm run check --workspace @kestrel/desktop",
    "test": "npm run test --workspace @kestrel/desktop --",
    "test:watch": "npm run test:watch --workspace @kestrel/desktop",
    "test:speech": "vite-node scripts/speech_highlight_harness.ts",
    "test:vad": "vite-node scripts/vad_dictation_harness.ts",
    "bindings:generate": "node scripts/generate-bindings.mjs",
    "bindings:check": "node scripts/generate-bindings.mjs --check",
    "architecture:check": "node scripts/check-architecture.mjs",
    "package:offline": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-offline.ps1",
    "launch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/launch-from-shortcut.ps1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "vite-node": "^6.0.0"
  }
}
