{
  "name": "kestrel-local",
  "private": true,
  "version": "0.16.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:speech": "npx vite-node scripts/speech_highlight_harness.ts",
    "test:vad": "npx vite-node scripts/vad_dictation_harness.ts",
    "package:offline": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-offline.ps1",
    "launch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/launch-from-shortcut.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "jsdom": "^29.0.1",
    "typescript": "~5.7.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
